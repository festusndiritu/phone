<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Contacts: names, photos, search -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Ongoing call runs as a phoneCall foreground service so Android accepts its call-style notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Star / unstar a contact (favorites row) -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Call log: list history, delete single entries -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- TelecomManager.placeCall -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- SIM slot number (1/2) in call history; held automatically with the default dialer role -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Incoming/ongoing call notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full-screen incoming call UI on lock screen (special access on Android 14+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Optional: documented background-activity-launch exemption; user must grant manually -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Proximity wake lock (screen off at ear) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dialer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.incall"
            android:excludeFromRecents="true"
            android:directBootAware="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <service
            android:name=".DialerInCallService"
            android:exported="true"
            android:directBootAware="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <!-- false: Telecom plays the ringtone itself (fastest, no app involvement) -->
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_RINGING" android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Off until "Silence unknown callers" is switched on in Settings (see Prefs / SettingsScreen), so it adds no per-call work otherwise -->
        <service
            android:name=".UnknownCallerScreeningService"
            android:exported="true"
            android:enabled="false"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver android:name=".CallActionReceiver" android:exported="false" android:directBootAware="true" />
    </application>
</manifest>