diff --git a/app/src/main/java/dev/mizzenmast/dialer/EndpointAudio.kt b/app/src/main/java/dev/mizzenmast/dialer/EndpointAudio.kt
new file mode 100644
index 0000000..3312a97
--- /dev/null
+++ b/app/src/main/java/dev/mizzenmast/dialer/EndpointAudio.kt
@@ -0,0 +1,50 @@
+package dev.mizzenmast.dialer
+
+import android.os.OutcomeReceiver
+import android.telecom.CallEndpoint
+import android.telecom.CallEndpointException
+import android.telecom.InCallService
+import androidx.annotation.RequiresApi
+import androidx.core.content.ContextCompat
+
+/**
+ * Call audio on Android 14+, where CallEndpoint replaces CallAudioState. Keeps the three things the callbacks deliver
+ * (current endpoint, available endpoints, mute) and publishes them in the [AudioUi] shape the UI already uses.
+ */
+@RequiresApi(34)
+internal class EndpointAudio(private val service: InCallService) {
+    private var current: CallEndpoint? = null
+    private var available: List<CallEndpoint> = emptyList()
+    private var muted = CallManager.audio.value?.muted ?: false
+
+    val hasState get() = current != null
+
+    fun onChanged(endpoint: CallEndpoint) { current = endpoint; publish() }
+    fun onAvailable(endpoints: List<CallEndpoint>) { available = endpoints; publish() }
+    fun onMuteChanged(isMuted: Boolean) { muted = isMuted; publish() }
+
+    /** Asks Telecom to move audio to [route]. False if no such endpoint is known (yet), so the caller can fall back. */
+    fun route(route: Int): Boolean {
+        val target = available.firstOrNull { routeOf(it.endpointType) == route } ?: return false
+        service.requestCallEndpointChange(target, ContextCompat.getMainExecutor(service), object : OutcomeReceiver<Void, CallEndpointException> {
+            override fun onResult(result: Void?) {}
+            override fun onError(error: CallEndpointException) { Diag.log("audio_route_failed", 0, "code=${error.code}") }
+        })
+        return true
+    }
+
+    private fun publish() {
+        val now = current ?: return
+        val route = routeOf(now.endpointType)
+        val mask = available.fold(route) { m, e -> m or routeOf(e.endpointType) }
+        CallManager.setAudio(AudioUi(route, mask, muted, if (route == AudioUi.BLUETOOTH) now.endpointName.toString() else null))
+    }
+
+    private fun routeOf(type: Int) = when (type) {
+        CallEndpoint.TYPE_EARPIECE -> AudioUi.EARPIECE
+        CallEndpoint.TYPE_BLUETOOTH -> AudioUi.BLUETOOTH
+        CallEndpoint.TYPE_WIRED_HEADSET -> AudioUi.WIRED
+        CallEndpoint.TYPE_SPEAKER -> AudioUi.SPEAKER
+        else -> 0
+    }
+}
diff --git a/app/src/main/java/dev/mizzenmast/dialer/HiddenApi.kt b/app/src/main/java/dev/mizzenmast/dialer/HiddenApi.kt
new file mode 100644
index 0000000..be22c40
--- /dev/null
+++ b/app/src/main/java/dev/mizzenmast/dialer/HiddenApi.kt
@@ -0,0 +1,44 @@
+package dev.mizzenmast.dialer
+
+import android.content.Context
+import android.provider.Settings
+import android.telecom.Call
+import android.telecom.PhoneAccountHandle
+import androidx.core.os.BundleCompat
+
+/**
+ * The few platform values this app needs that are not in the public SDK, kept in one place. They are read defensively:
+ * if a platform release changes one, a single feature degrades (no video-upgrade button, SIM list from our own query)
+ * instead of the call screen failing.
+ */
+object HiddenApi {
+    /** Call.Details.CAPABILITY_CAN_UPGRADE_TO_VIDEO; the same bit as Connection's. */
+    private const val CAPABILITY_CAN_UPGRADE_TO_VIDEO = 0x00080000
+
+    /** Call.AVAILABLE_PHONE_ACCOUNTS: the accounts Telecom offers while it waits for a SIM to be chosen. */
+    private const val EXTRA_AVAILABLE_PHONE_ACCOUNTS = "selectPhoneAccountAccounts"
+
+    /** Settings.Secure.INCALL_POWER_BUTTON_BEHAVIOR: 1 turns the screen off, 2 hangs up. */
+    private const val SETTING_POWER_BUTTON_BEHAVIOR = "incall_power_button_behavior"
+    private const val POWER_BUTTON_HANGS_UP = 2
+
+    /** "This call can be switched to video": the hidden capability bit, or the public "both sides can send and receive" bits. */
+    fun canUpgradeToVideo(call: Call): Boolean {
+        val caps = call.details.callCapabilities
+        val local = Call.Details.CAPABILITY_SUPPORTS_VT_LOCAL_BIDIRECTIONAL
+        val remote = Call.Details.CAPABILITY_SUPPORTS_VT_REMOTE_BIDIRECTIONAL
+        return (caps and CAPABILITY_CAN_UPGRADE_TO_VIDEO) != 0 || ((caps and local) == local && (caps and remote) == remote)
+    }
+
+    /** The accounts Telecom is asking the person to pick from, or null when it isn't (or the extra is missing). */
+    fun offeredPhoneAccounts(call: Call): List<PhoneAccountHandle>? = try {
+        call.details.extras
+            ?.let { BundleCompat.getParcelableArrayList(it, EXTRA_AVAILABLE_PHONE_ACCOUNTS, PhoneAccountHandle::class.java) }
+            ?.takeIf { it.isNotEmpty() }
+    } catch (e: Exception) { Diag.fail("offered_accounts", e); null }
+
+    /** True when pressing power during a call hangs up. Assumes it does if the setting can't be read, which keeps the screen on. */
+    fun powerButtonEndsCall(ctx: Context): Boolean = try {
+        Settings.Secure.getInt(ctx.contentResolver, SETTING_POWER_BUTTON_BEHAVIOR, 1) == POWER_BUTTON_HANGS_UP
+    } catch (e: Exception) { Diag.fail("power_button_ends_call", e); true }
+}
